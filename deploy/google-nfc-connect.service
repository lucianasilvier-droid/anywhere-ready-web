# systemd unit for a VPS without Docker.
#   sudo cp deploy/google-nfc-connect.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now google-nfc-connect
#   journalctl -u google-nfc-connect -f
[Unit]
Description=Google NFC Connect (Node.js)
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/google-nfc-connect
EnvironmentFile=/var/www/google-nfc-connect/.env
Environment=NODE_ENV=production
ExecStartPre=/usr/bin/node scripts/migrate.mjs
ExecStart=/usr/bin/node start.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
