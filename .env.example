# Copy to .env and fill in. Never commit the real .env.
# In Docker / pm2 / systemd / host panels, set these as environment variables.

# ------------------------------------------------------------------ App
# Public address of the site (links in e-mails, Google login, sitemap, backups).
APP_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0
# Upload size limit in MB (backup ZIPs, photos).
MAX_BODY_MB=10

# ------------------------------------------------------------------ Database (PostgreSQL 13+)
# Any Postgres: local, Docker, Neon, Supabase, RDS, Railway, Render…
DATABASE_URL=postgres://nfc:troque-esta-senha@localhost:5432/nfc
# "true" for managed databases that require TLS (or put ?sslmode=require in the URL).
DATABASE_SSL=
# docker-compose.yml only (builds DATABASE_URL for the bundled Postgres):
POSTGRES_DB=nfc
POSTGRES_USER=nfc
POSTGRES_PASSWORD=troque-esta-senha

# ------------------------------------------------------------------ Authentication
# Administrators by e-mail (comma-separated), besides the owner already in the code.
ADMIN_EMAILS=
# Close public sign-up (only invitations).
AUTH_DISABLE_SIGNUP=false
# Ask new accounts to confirm their e-mail. Default: on when SMTP is configured.
AUTH_REQUIRE_EMAIL_CONFIRMATION=
# Session length in days.
SESSION_DAYS=30
# Force the Secure cookie flag ("true" behind HTTPS). Default: detected per request.
COOKIE_SECURE=
# Optional starting password for the owner (retired after they change it in the panel).
# Prefer: npm run admin:create -- email "senha"
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Optional "Continuar com Google". Authorized redirect URI in Google Cloud:
#   <APP_URL>/api/auth/google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------ E-mail (SMTP)
# Without SMTP_HOST, e-mail links are printed in the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Google NFC Connect <no-reply@seu-dominio.com.br>"

# ------------------------------------------------------------------ File storage
# local = files on disk (mount STORAGE_DIR as a volume); s3 = any S3-compatible bucket.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=us-east-1
# Leave empty for AWS; e.g. https://<account>.r2.cloudflarestorage.com for R2,
# http://localhost:9000 for MinIO.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=

# ------------------------------------------------------------------ Integrations
ANTHROPIC_API_KEY=
GOOGLE_MAPS_API_KEY=
GROQ_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
